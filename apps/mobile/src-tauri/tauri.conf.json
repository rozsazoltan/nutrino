{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nutrino",
  "version": "0.11.16",
  "identifier": "net.datarose.nutrino.mobile",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nutrino Mobile Preview",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1116
    }
  }
}

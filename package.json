{
  "name": "nutrino",
  "private": true,
  "version": "0.11.18",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "dev:desktop": "pnpm --filter nutrino-desktop tauri:dev",
    "dev:android": "pnpm --filter nutrino-mobile android:dev",
    "dev:ios": "pnpm --filter nutrino-mobile ios:dev",
    "build:desktop": "pnpm --filter nutrino-desktop tauri:build",
    "build:android": "pnpm --filter nutrino-mobile android:build",
    "build:ios": "pnpm --filter nutrino-mobile ios:build",
    "init:android": "pnpm --filter nutrino-mobile android:init",
    "init:ios": "pnpm --filter nutrino-mobile ios:init",
    "reset:android": "pnpm --filter nutrino-mobile android:reset",
    "check:vue-i18n-quotes": "node scripts/check-vue-i18n-quotes.mjs",
    "check:vue-sfc-syntax": "node scripts/check-vue-sfc-syntax.mjs",
    "check:i18n": "pnpm check:vue-i18n-quotes && pnpm check:vue-sfc-syntax && pnpm check:i18n-completeness && pnpm check:desktop-raw-i18n-keys",
    "check:i18n-completeness": "node scripts/check-i18n-completeness.mjs",
    "check:android-mainactivity-bridge": "node scripts/check-android-mainactivity-bridge.mjs",
    "check:desktop-raw-i18n-keys": "node scripts/check-desktop-raw-i18n-keys.mjs",
    "prune:android": "pnpm --filter nutrino-mobile android:prune",
    "size:android": "pnpm --filter nutrino-mobile android:size"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/rozsazoltan/nutrino.git"
  },
  "bugs": {
    "url": "https://github.com/rozsazoltan/nutrino/issues"
  },
  "homepage": "https://github.com/rozsazoltan/nutrino#readme",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

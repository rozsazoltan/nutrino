amends "package://github.com/jdx/hk/releases/download/v1.47.0/hk@1.47.0#/Config.pkl"

local defaultShell = new Script {
  linux = "sh -o errexit -c"
  macos = "sh -o errexit -c"
  windows = "cmd /d /s /c"
  other = "sh -o errexit -c"
}

local formatSteps = new Mapping<String, Step> {
  ["format-js"] {
    shell = defaultShell
    check = "aube run format:js:check"
    fix = "aube run format:js"
    stage = List(
      "package.json",
      "vitest.config.ts",
      "apps/mobile/src/lib/*.ts",
      "scripts/*.mjs",
    )
  }

  ["format-rust"] {
    shell = defaultShell
    check = "aube run format:rust:check"
    fix = "aube run format:rust"
    stage = List("apps/*/src-tauri/**/*.rs")
  }
}

local qualitySteps = new Mapping<String, Step> {
  ["quality-commit"] {
    shell = defaultShell
    depends = List("format-js", "format-rust")
    exclusive = true
    check = "aube run quality:commit"
  }

  ["quality-push"] {
    shell = defaultShell
    depends = List("format-js", "format-rust")
    exclusive = true
    check = "aube run quality:push"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    steps = new Mapping<String, Step> {
      ["format-js"] = formatSteps["format-js"]
      ["format-rust"] = formatSteps["format-rust"]
      ["quality-commit"] = qualitySteps["quality-commit"]
    }
  }

  ["pre-push"] {
    steps = new Mapping<String, Step> {
      ["format-js"] = formatSteps["format-js"]
      ["format-rust"] = formatSteps["format-rust"]
      ["quality-push"] = qualitySteps["quality-push"]
    }
  }

  ["fix"] {
    fix = true
    steps = formatSteps
  }

  ["check"] {
    steps = new Mapping<String, Step> {
      ["format-js"] = formatSteps["format-js"]
      ["format-rust"] = formatSteps["format-rust"]
      ["quality-push"] = qualitySteps["quality-push"]
    }
  }
}

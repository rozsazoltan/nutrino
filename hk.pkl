amends "package://github.com/jdx/hk/releases/download/v1.18.1/hk@1.18.1#/Config.pkl"

local jsFormatters = new Mapping<String, Step> {
  ["oxfmt"] {
    glob = List(
      "apps/mobile/src/lib/**/*.ts",
      "apps/desktop/src/lib/**/*.ts",
      "vitest.config.ts",
      "scripts/**/*.mjs",
    )
    check = "aube run format:js:check"
    fix = "aube run format:js"
  }
}

local rustFormatters = new Mapping<String, Step> {
  ["rustfmt"] {
    glob = List(
      "apps/desktop/src-tauri/**/*.rs",
      "apps/mobile/src-tauri/**/*.rs",
    )
    check = "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check && cargo fmt --manifest-path apps/mobile/src-tauri/Cargo.toml -- --check"
    fix = "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml && cargo fmt --manifest-path apps/mobile/src-tauri/Cargo.toml"
  }
}

local qualityChecks = new Mapping<String, Step> {
  ["js-quality"] {
    glob = List(
      "apps/mobile/src/lib/**/*.ts",
      "apps/desktop/src/lib/**/*.ts",
      "scripts/**/*.mjs",
      "vitest.config.ts",
      "package.json",
      "aube-workspace.yaml",
    )
    check = "aube run test:js && aube run test:app && aube run check:i18n && aube run check:android-mainactivity-bridge && aube run check:release-workflows"
  }

  ["rust-quality"] {
    glob = List(
      "apps/desktop/src-tauri/**/*.rs",
      "apps/desktop/src-tauri/Cargo.toml",
      "apps/mobile/src-tauri/**/*.rs",
      "apps/mobile/src-tauri/Cargo.toml",
      "scripts/check-rust-tauri-config.mjs",
    )
    check = "aube run test:rust"
  }
}

local formatters = new Mapping<String, Step> {
  ["oxfmt"] {
    glob = List(
      "apps/mobile/src/lib/**/*.ts",
      "apps/desktop/src/lib/**/*.ts",
      "vitest.config.ts",
      "scripts/**/*.mjs",
    )
    check = "aube run format:js:check"
    fix = "aube run format:js"
  }

  ["rustfmt"] {
    glob = List(
      "apps/desktop/src-tauri/**/*.rs",
      "apps/mobile/src-tauri/**/*.rs",
    )
    check = "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check && cargo fmt --manifest-path apps/mobile/src-tauri/Cargo.toml -- --check"
    fix = "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml && cargo fmt --manifest-path apps/mobile/src-tauri/Cargo.toml"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = formatters
  }

  ["fix"] {
    fix = true
    steps = formatters
  }

  ["check"] {
    steps = formatters
  }

  ["pre-push"] {
    steps = qualityChecks
  }

  ["quality"] {
    steps = qualityChecks
  }

  ["fix-js"] {
    fix = true
    steps = jsFormatters
  }

  ["check-js"] {
    steps = jsFormatters
  }

  ["fix-rust"] {
    fix = true
    steps = rustFormatters
  }

  ["check-rust"] {
    steps = rustFormatters
  }
}

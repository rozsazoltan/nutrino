amends "package://github.com/jdx/hk/releases/download/v1.47.0/hk@1.47.0#/Config.pkl"

local defaultShell = new Script {
  linux = "sh -o errexit -c"
  macos = "sh -o errexit -c"
  windows = "cmd /d /s /c"
  other = "sh -o errexit -c"
}

local formatSteps = new Mapping<String, Step> {
  ["format-js"] {
    shell = defaultShell
    check = "aube run format:js:check"
    fix = "aube run format:js"
    stage = List(
      "package.json",
      "vitest.config.ts",
      "apps/mobile/src/lib/*.ts",
      "scripts/*.mjs",
    )
  }

  ["format-rust"] {
    shell = defaultShell
    check = "aube run format:rust:check"
    fix = "aube run format:rust"
    stage = List("apps/*/src-tauri/**/*.rs")
  }
}

local qualitySteps = new Mapping<String, Step> {
  ["test-js"] {
    shell = defaultShell
    check = "aube run test:js"
  }

  ["test-app"] {
    shell = defaultShell
    check = "aube run test:app"
  }

  ["test-rust"] {
    shell = defaultShell
    check = "aube run test:rust"
  }

  ["check-i18n"] {
    shell = defaultShell
    check = "aube run check:i18n"
  }

  ["check-android-bridge"] {
    shell = defaultShell
    check = "aube run check:android-mainactivity-bridge"
  }

  ["check-release-workflows"] {
    shell = defaultShell
    check = "aube run check:release-workflows"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    steps = formatSteps
  }

  ["pre-push"] {
    steps = qualitySteps
  }

  ["fix"] {
    fix = true
    steps = formatSteps
  }

  ["check"] {
    steps = new Mapping<String, Step> {
      ["format-js"] = formatSteps["format-js"]
      ["format-rust"] = formatSteps["format-rust"]
      ["test-js"] = qualitySteps["test-js"]
      ["test-app"] = qualitySteps["test-app"]
      ["test-rust"] = qualitySteps["test-rust"]
      ["check-i18n"] = qualitySteps["check-i18n"]
      ["check-android-bridge"] = qualitySteps["check-android-bridge"]
      ["check-release-workflows"] = qualitySteps["check-release-workflows"]
    }
  }
}

# Dependencies
node_modules/
.aube/
.pnp.*

# Package-manager lock files
# Nutrino uses aube with catalog-managed dependencies.
# Cargo.lock stays tracked because release versioning updates Tauri app package versions.
aube.lock
aube-lock.yaml
package-lock.json
yarn.lock
bun.lockb
pnpm-lock.yaml


# Build output
dist/
build/
coverage/
.vite/

# Local caches
.cache/
.tauri-release-work/
**/.cache/
**/.vite/

# Tauri / Rust
/target/
**/src-tauri/target/
**/src-tauri/gen/android/.gradle/
**/src-tauri/gen/android/build/
**/src-tauri/gen/apple/build/
**/src-tauri/gen/schemas/
**/src-tauri/gen/android/keystore.properties
**/src-tauri/gen/android/*.jks
**/src-tauri/gen/android/*.jks.base64
**/src-tauri/gen/android/*.keystore
**/src-tauri/gen/android/*.keystore.base64
**/src-tauri/gen/android/*.p12
**/src-tauri/gen/android/*.p12.base64

# Generated mobile projects can be recreated with aube run init:android / aube run init:ios.
# Keep this commented if you intentionally commit native generated projects.
# apps/mobile/src-tauri/gen/

# Local app data
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Local env
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
aube-debug.log*
